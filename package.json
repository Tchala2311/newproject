{
  "name": "loop-mini-games",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "tunnel": "expo start --tunnel",
    "fix": "expo install --fix",
    "typecheck": "tsc --noEmit",
    "eas:init": "eas init",
    "eas:build:dev": "eas build --profile development --platform all",
    "eas:build:preview": "eas build --profile preview --platform all",
    "eas:update": "eas update --branch preview --message \"$(git log -1 --pretty=%B)\""
  },
  "dependencies": {
    "@expo-google-fonts/space-grotesk": "^0.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.45.0",
    "react-native-url-polyfill": "^2.0.0",
    "expo": "~54.0.0",
    "expo-audio": "~1.0.0",
    "expo-blur": "~15.0.0",
    "expo-font": "~14.0.0",
    "expo-haptics": "~15.0.0",
    "expo-linear-gradient": "~15.0.0",
    "expo-status-bar": "~3.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-system-ui": "~5.0.0",
    "react": "19.1.0",
    "react-native": "0.81.0",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-safe-area-context": "5.0.0",
    "react-native-svg": "15.12.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.0",
    "typescript": "~5.6.0"
  }
