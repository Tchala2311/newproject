# Supabase — copy this file to `.env` and fill in your project's values.
# `.env` is git-ignored. Never commit real keys.
#
# Get these from: https://supabase.com/dashboard/project/_/settings/api
#
# EXPO_PUBLIC_* vars are inlined into the JS bundle and visible to anyone
# who downloads the app. That's fine for the anon key — RLS policies in
# supabase/schema.sql are what actually protect data.
#
# NEVER put the service_role key in any EXPO_PUBLIC_ var or any client file.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...replace-with-anon-key
