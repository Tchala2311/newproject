{
  "expo": {
    "name": "FLIK",
    "slug": "flik",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "flik",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.flik.games",
      "infoPlist": {
        "UIStatusBarStyle": "UIStatusBarStyleLightContent",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "app.flik.games",
      "adaptiveIcon": {
        "backgroundColor": "#060610"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
